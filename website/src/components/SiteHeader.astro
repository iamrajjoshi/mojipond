---
import appIcon from "../../../Resources/Assets.xcassets/AppIcon.appiconset/icon-128.png";
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="MojiPond home">
    <img src={appIcon.src} width="40" height="40" alt="" />
    <span>MojiPond</span>
  </a>
</header>

<style>
  .site-header {
    position: absolute;
    top: 24px;
    left: 32px;
    z-index: 30;
  }

  .wordmark {
    display: inline-flex;
    gap: 12px;
    min-height: 48px;
    align-items: center;
    color: var(--deep-water);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  img {
    display: block;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgb(6 51 61 / 20%);
  }

  @media (max-width: 520px) {
    .site-header {
      top: 16px;
      left: 16px;
    }

    .wordmark {
      gap: 8px;
      font-size: 1rem;
    }

    img {
      width: 36px;
      height: 36px;
      border-radius: 8px;
    }
  }
</style>
