---
import appIcon from "../../../Resources/Assets.xcassets/AppIcon.appiconset/icon-128.png";

interface Props {
  inverse?: boolean;
  showRepository?: boolean;
}

const { inverse = false, showRepository = false } = Astro.props;
const repositoryURL = "https://github.com/iamrajjoshi/mojipond";
---

<header class:list={["site-header", { inverse }]}>
  <a class="wordmark" href="/" aria-label="MojiPond home">
    <img src={appIcon.src} width="40" height="40" alt="" />
    <span>MojiPond</span>
  </a>
  {
    showRepository && (
      <a class="repository-link" href={repositoryURL}>
        GitHub
      </a>
    )
  }
</header>

<style>
  .site-header {
    position: absolute;
    top: 24px;
    left: 32px;
    right: 32px;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark {
    display: inline-flex;
    gap: 12px;
    min-height: 48px;
    align-items: center;
    color: var(--deep-water);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .inverse .wordmark {
    color: #f5fffd;
    text-shadow: 0 2px 14px rgb(0 20 28 / 55%);
  }

  .repository-link {
    display: inline-flex;
    min-height: 44px;
    padding: 8px 0;
    align-items: center;
    color: var(--deep-water);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .inverse .repository-link {
    color: #f5fffd;
    text-shadow: 0 2px 14px rgb(0 20 28 / 55%);
  }

  .repository-link:hover {
    text-decoration-color: currentcolor;
  }

  img {
    display: block;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgb(6 51 61 / 20%);
  }

  .inverse img {
    box-shadow: 0 10px 30px rgb(0 17 24 / 42%);
  }

  @media (max-width: 520px) {
    .site-header {
      top: 16px;
      left: 16px;
      right: 16px;
    }

    .wordmark {
      gap: 8px;
      font-size: 1rem;
    }

    img {
      width: 36px;
      height: 36px;
      border-radius: 8px;
    }
  }
</style>
