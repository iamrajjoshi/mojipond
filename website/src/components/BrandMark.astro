---
interface Props {
  size: number;
}

const { size } = Astro.props;
---

<svg
  class="brand-mark"
  width={size}
  height={size}
  viewBox="0 0 36 36"
  aria-hidden="true"
>
  <circle class="colon" cx="18" cy="6" r="2.7"></circle>
  <circle class="colon" cx="18" cy="14" r="2.7"></circle>
  <path
    class="ripple"
    d="M5 22.5c4.3-3 8.7-3 13 0s8.7 3 13 0M8 30c3.3-2.5 6.7-2.5 10 0s6.7 2.5 10 0"
  ></path>
</svg>

<style>
  .brand-mark {
    display: block;
    flex: none;
    overflow: visible;
  }

  .colon {
    fill: var(--coral);
  }

  .ripple {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2.8;
  }
</style>
