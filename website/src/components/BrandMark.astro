---
interface Props {
  size: number;
}

const { size } = Astro.props;
---

<svg
  class="brand-mark"
  width={size}
  height={size}
  viewBox="0 0 48 48"
  aria-hidden="true"
>
  <rect width="48" height="48" rx="14" fill="var(--pond-deep)"></rect>
  <path
    d="M9 29.5c4.1-2.3 9.1-3.5 15-3.5s10.9 1.2 15 3.5M12 35c3.4-1.8 7.4-2.7 12-2.7s8.6.9 12 2.7"
    fill="none"
    stroke="var(--pond-mist)"
    stroke-linecap="round"
    stroke-width="1.6"
    opacity=".65"></path>
  <path
    d="M25.2 9.7c7.7.5 13.5 6.7 13.5 14.2 0 1.1-.1 2.1-.4 3.1l-8-4.6-5.1 8.8a14.2 14.2 0 1 1 0-21.5Z"
    fill="var(--lily)"></path>
  <path d="m30.3 22.4 8 4.6" stroke="var(--pond-deep)" stroke-width="1.5"
  ></path>
  <circle cx="19" cy="19" r="2.1" fill="var(--paper)" opacity=".88"></circle>
  <circle cx="25" cy="15.7" r="1.3" fill="var(--paper)" opacity=".72"></circle>
</svg>

<style>
  .brand-mark {
    display: block;
    flex: none;
    filter: drop-shadow(0 6px 12px rgb(4 54 61 / 18%));
  }
</style>
