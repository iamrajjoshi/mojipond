---
import { getImage } from "astro:assets";
import desktopSource from "../assets/pond-hero-desktop.png";
import mobileSource from "../assets/pond-hero-mobile.png";

const desktop = await getImage({
  src: desktopSource,
  format: "webp",
  quality: 86,
});
const mobile = await getImage({
  src: mobileSource,
  format: "webp",
  quality: 86,
});
---

<picture class="pond-scene" aria-hidden="true">
  <source media="(max-width: 700px)" srcset={mobile.src} />
  <img
    src={desktop.src}
    alt=""
    width={desktop.attributes.width}
    height={desktop.attributes.height}
    loading="eager"
    fetchpriority="high"
  />
</picture>

<style>
  .pond-scene,
  .pond-scene img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .pond-scene img {
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 700px) {
    .pond-scene img {
      object-position: center top;
    }
  }
</style>
