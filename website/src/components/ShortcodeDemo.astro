---
import appIcon from "../../../Resources/Assets.xcassets/AppIcon.appiconset/icon-64.png";

const emojiOptions = [
  { shortcode: "wave", emoji: "👋", name: "Waving hand" },
  { shortcode: "warning", emoji: "⚠️", name: "Warning" },
  { shortcode: "watch", emoji: "⌚", name: "Watch" },
  { shortcode: "watermelon", emoji: "🍉", name: "Watermelon" },
  {
    shortcode: "waning_crescent_moon",
    emoji: "🌘",
    name: "Waning crescent moon",
  },
  { shortcode: "frog", emoji: "🐸", name: "Frog" },
  { shortcode: "lizard", emoji: "🦎", name: "Lizard" },
  { shortcode: "lotus", emoji: "🪷", name: "Lotus" },
  { shortcode: "sparkles", emoji: "✨", name: "Sparkles" },
  { shortcode: "duck", emoji: "🦆", name: "Duck" },
  { shortcode: "joy", emoji: "😂", name: "Face with tears of joy" },
  { shortcode: "heart_eyes", emoji: "😍", name: "Heart eyes" },
];

const initialResults = emojiOptions.slice(0, 5);
---

<div
  class="shortcode-demo"
  data-shortcode-demo
  data-options={JSON.stringify(emojiOptions)}
>
  <div class="demo-presets" role="group" aria-label="Example shortcuts">
    <span>Try one</span>
    <button type="button" data-preset=":wa">:wave:</button>
    <button type="button" data-preset=":fr">:frog:</button>
    <button type="button" data-preset=":spa">:sparkles:</button>
  </div>

  <div class="message-window">
    <div class="message-bar" aria-hidden="true">
      <img src={appIcon.src} width="40" height="40" alt="" />
      <span>New message</span>
    </div>

    <div class="composer">
      <label class="sr-only" for="shortcode-input">Message</label>
      <input
        id="shortcode-input"
        type="text"
        value="That fixed it :wa"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="true"
        aria-controls="shortcode-suggestions"
        aria-activedescendant="shortcode-option-wave"
        data-shortcode-input
      />
    </div>

    <div
      class="suggestions"
      id="shortcode-suggestions"
      role="listbox"
      aria-label="Emoji suggestions"
      data-shortcode-suggestions
    >
      {
        initialResults.map((option, index) => (
          <button
            id={`shortcode-option-${option.shortcode}`}
            class:list={["suggestion", { selected: index === 0 }]}
            type="button"
            role="option"
            aria-selected={index === 0 ? "true" : "false"}
            tabindex="-1"
            data-option={option.shortcode}
          >
            <span class="emoji" aria-hidden="true">
              {option.emoji}
            </span>
            <span class="suggestion-copy">
              <strong>:{option.shortcode}:</strong>
              <small>{option.name}</small>
            </span>
            <span class="selected-mark" aria-hidden="true">
              ✓
            </span>
          </button>
        ))
      }
    </div>

    <div class="demo-keys" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> choose</span>
      <span><kbd>Tab</kbd> or <kbd>Return</kbd> insert</span>
      <span><kbd>Esc</kbd> close</span>
    </div>
  </div>

  <p class="sr-only" aria-live="polite" data-shortcode-status></p>
</div>

<script>
  interface EmojiOption {
    shortcode: string;
    emoji: string;
    name: string;
  }

  interface ActiveToken {
    start: number;
    end: number;
    query: string;
    closed: boolean;
  }

  const root = document.querySelector("[data-shortcode-demo]");

  if (root instanceof HTMLElement) {
    const input = root.querySelector("[data-shortcode-input]");
    const listbox = root.querySelector("[data-shortcode-suggestions]");
    const status = root.querySelector("[data-shortcode-status]");
    const parsedOptions: unknown = JSON.parse(root.dataset.options ?? "[]");
    const options = Array.isArray(parsedOptions)
      ? (parsedOptions as EmojiOption[])
      : [];

    if (
      input instanceof HTMLInputElement &&
      listbox instanceof HTMLElement &&
      status instanceof HTMLParagraphElement
    ) {
      let matches = options.slice(0, 5);
      let selectedIndex = 0;
      let activeToken: ActiveToken | null = null;

      const findActiveToken = (): ActiveToken | null => {
        const caret = input.selectionStart ?? input.value.length;
        const beforeCaret = input.value.slice(0, caret);
        const match = beforeCaret.match(/(^|[\s([{\"'])(:[a-z0-9_+\-]*:?)$/i);
        if (!match) return null;

        const rawToken = match[2];
        const closed = rawToken.length > 1 && rawToken.endsWith(":");
        const query = rawToken
          .slice(1, closed ? -1 : undefined)
          .toLocaleLowerCase();

        return {
          start: caret - rawToken.length,
          end: caret,
          query,
          closed,
        };
      };

      const closeSuggestions = () => {
        matches = [];
        activeToken = null;
        listbox.hidden = true;
        input.setAttribute("aria-expanded", "false");
        input.removeAttribute("aria-activedescendant");
      };

      const renderSuggestions = () => {
        if (matches.length === 0) {
          closeSuggestions();
          return;
        }

        const rows = matches.map((option, index) => {
          const row = document.createElement("button");
          const emoji = document.createElement("span");
          const copy = document.createElement("span");
          const shortcode = document.createElement("strong");
          const name = document.createElement("small");
          const selectedMark = document.createElement("span");
          const isSelected = index === selectedIndex;

          row.id = `shortcode-option-${option.shortcode}`;
          row.className = `suggestion${isSelected ? " selected" : ""}`;
          row.type = "button";
          row.tabIndex = -1;
          row.setAttribute("role", "option");
          row.setAttribute("aria-selected", String(isSelected));
          row.dataset.option = option.shortcode;

          emoji.className = "emoji";
          emoji.setAttribute("aria-hidden", "true");
          emoji.textContent = option.emoji;

          copy.className = "suggestion-copy";
          shortcode.textContent = `:${option.shortcode}:`;
          name.textContent = option.name;
          copy.append(shortcode, name);

          selectedMark.className = "selected-mark";
          selectedMark.setAttribute("aria-hidden", "true");
          selectedMark.textContent = "✓";

          row.append(emoji, copy, selectedMark);
          return row;
        });

        listbox.replaceChildren(...rows);
        listbox.hidden = false;
        input.setAttribute("aria-expanded", "true");
        input.setAttribute("aria-activedescendant", rows[selectedIndex].id);
      };

      const insertOption = (option: EmojiOption) => {
        if (!activeToken) return;

        input.setRangeText(
          option.emoji,
          activeToken.start,
          activeToken.end,
          "end",
        );
        closeSuggestions();
        status.textContent = `Inserted ${option.name}.`;
        input.focus();
        input.dispatchEvent(new Event("change", { bubbles: true }));
      };

      const updateSuggestions = () => {
        activeToken = findActiveToken();
        if (!activeToken) {
          closeSuggestions();
          return;
        }

        if (activeToken.closed) {
          const exactMatch = options.find(
            (option) => option.shortcode === activeToken?.query,
          );
          if (exactMatch) {
            insertOption(exactMatch);
            return;
          }
        }

        matches = options
          .filter(
            (option) =>
              option.shortcode.startsWith(activeToken?.query ?? "") ||
              option.name
                .toLocaleLowerCase()
                .includes(activeToken?.query ?? ""),
          )
          .slice(0, 5);
        selectedIndex = 0;
        renderSuggestions();
        status.textContent =
          matches.length === 0
            ? "No emoji suggestions."
            : `${matches.length} emoji suggestion${matches.length === 1 ? "" : "s"}.`;
      };

      const moveSelection = (offset: number) => {
        selectedIndex =
          (selectedIndex + offset + matches.length) % matches.length;
        renderSuggestions();
        const selected = matches[selectedIndex];
        status.textContent = `${selected.name}, ${selectedIndex + 1} of ${matches.length}.`;
        document
          .getElementById(`shortcode-option-${selected.shortcode}`)
          ?.scrollIntoView({ block: "nearest" });
      };

      input.addEventListener("input", updateSuggestions);
      input.addEventListener("click", updateSuggestions);
      input.addEventListener("keyup", (event) => {
        if (
          ["ArrowUp", "ArrowDown", "Enter", "Tab", "Escape"].includes(event.key)
        ) {
          return;
        }
        updateSuggestions();
      });

      input.addEventListener("keydown", (event) => {
        if (
          matches.length === 0 ||
          input.getAttribute("aria-expanded") !== "true"
        ) {
          return;
        }

        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          moveSelection(event.key === "ArrowDown" ? 1 : -1);
          return;
        }

        if (event.key === "Tab" || event.key === "Enter") {
          event.preventDefault();
          insertOption(matches[selectedIndex]);
          return;
        }

        if (event.key === "Escape") {
          event.preventDefault();
          closeSuggestions();
          status.textContent = "Suggestions closed.";
        }
      });

      listbox.addEventListener("pointerdown", (event) => {
        event.preventDefault();
      });

      listbox.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const row = target.closest<HTMLElement>("[data-option]");
        const option = options.find(
          (candidate) => candidate.shortcode === row?.dataset.option,
        );
        if (option) insertOption(option);
      });

      root
        .querySelectorAll<HTMLButtonElement>("[data-preset]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            input.value = `That fixed it ${button.dataset.preset ?? ":"}`;
            input.focus();
            input.setSelectionRange(input.value.length, input.value.length);
            updateSuggestions();
          });
        });

      input.setSelectionRange(input.value.length, input.value.length);
      updateSuggestions();
    }
  }
</script>

<style>
  .shortcode-demo {
    width: 100%;
  }

  .demo-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
    align-items: center;
  }

  .demo-presets span {
    margin-right: 4px;
    color: var(--ink-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .demo-presets button {
    min-height: 40px;
    padding: 8px 12px;
    color: var(--deep-water);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    background: var(--paper-strong);
    border: 1px solid var(--line);
    border-radius: 12px;
    cursor: pointer;
    transition:
      color 260ms cubic-bezier(0.32, 0.72, 0, 1),
      background-color 260ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 260ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .demo-presets button:hover {
    color: white;
    background: var(--pond);
  }

  .demo-presets button:active {
    transform: translateY(1px) scale(0.98);
  }

  .message-window {
    overflow: hidden;
    background: var(--paper-strong);
    border: 1px solid var(--line);
    border-radius: 24px;
    box-shadow: 0 32px 80px rgb(6 51 61 / 18%);
  }

  .message-bar {
    display: flex;
    gap: 12px;
    min-height: 64px;
    padding: 12px 16px;
    align-items: center;
    color: var(--deep-water);
    font-size: 0.875rem;
    font-weight: 700;
    background: #eef5f2;
  }

  .message-bar img {
    display: block;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgb(6 51 61 / 16%);
  }

  .composer {
    padding: 16px;
  }

  input {
    width: 100%;
    min-height: 52px;
    padding: 12px 16px;
    color: var(--deep-water);
    font: inherit;
    font-size: 1rem;
    background: white;
    border: 1px solid rgb(6 51 61 / 24%);
    border-radius: 16px;
    outline: none;
    transition:
      border-color 260ms cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 260ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  input:focus {
    border-color: var(--ripple);
    box-shadow: 0 0 0 4px rgb(33 143 163 / 16%);
  }

  .suggestions {
    display: grid;
    gap: 2px;
    padding: 0 8px 8px;
  }

  .suggestions :global(.suggestion) {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 24px;
    gap: 12px;
    width: 100%;
    min-height: 64px;
    padding: 8px 12px;
    align-items: center;
    color: var(--deep-water);
    text-align: left;
    background: transparent;
    border: 0;
    border-radius: 16px;
    cursor: pointer;
    transition:
      color 260ms cubic-bezier(0.32, 0.72, 0, 1),
      background-color 260ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 260ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .suggestions :global(.suggestion:hover:not(.selected)) {
    background: #edf4f0;
  }

  .suggestions :global(.suggestion:active) {
    transform: scale(0.99);
  }

  .suggestions :global(.suggestion.selected) {
    color: white;
    background: var(--deep-water);
  }

  .suggestions :global(.emoji) {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    font-family: system-ui, sans-serif;
    font-size: 1.875rem;
    background: rgb(255 255 255 / 78%);
    border-radius: 12px;
  }

  .suggestions :global(.suggestion-copy) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .suggestions :global(.suggestion-copy strong) {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 1rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .suggestions :global(.suggestion-copy small) {
    overflow: hidden;
    color: var(--ink-muted);
    font-size: 0.875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .suggestions :global(.selected .suggestion-copy small) {
    color: #cfe4e2;
  }

  .suggestions :global(.selected-mark) {
    display: none;
    font-weight: 700;
    text-align: center;
  }

  .suggestions :global(.selected .selected-mark) {
    display: block;
  }

  .demo-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    min-height: 48px;
    padding: 12px 16px;
    align-items: center;
    color: var(--ink-muted);
    font-size: 0.75rem;
    font-weight: 600;
    background: #eef5f2;
  }

  .demo-keys span {
    display: inline-flex;
    gap: 4px;
    align-items: center;
  }

  kbd {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  @media (max-width: 520px) {
    .demo-presets span {
      flex-basis: 100%;
    }

    .message-window {
      border-radius: 16px;
    }

    .message-bar,
    .composer {
      padding-inline: 12px;
    }

    .suggestions :global(.suggestion) {
      grid-template-columns: 44px minmax(0, 1fr) 20px;
      gap: 8px;
      padding-inline: 8px;
    }

    .suggestions :global(.emoji) {
      width: 44px;
      height: 44px;
      font-size: 1.5rem;
    }

    .demo-keys {
      gap: 8px 12px;
    }
  }
</style>
