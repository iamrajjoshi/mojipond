---
import BrandMark from "./BrandMark.astro";
---

<footer class="site-footer">
  <div class="footer-brand">
    <BrandMark size={32} />
    <div>
      <strong>MojiPond</strong>
      <span>Emoji shortcuts for macOS.</span>
    </div>
  </div>
  <nav aria-label="Footer navigation">
    <a href="/privacy/">Privacy</a>
    <a href="/terms/">Terms</a>
    <a href="/#faq">FAQ</a>
  </nav>
  <p>Built for macOS 14 and newer.</p>
</footer>

<style>
  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: center;
    width: var(--content-width);
    margin: 0 auto;
    padding: 48px 0;
    color: var(--ink-muted);
    font-size: 0.875rem;
  }

  .footer-brand {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .footer-brand div {
    display: grid;
  }

  .footer-brand strong {
    color: var(--ink);
  }

  nav {
    display: flex;
    gap: 24px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--ink);
  }

  p {
    grid-column: 1 / -1;
    margin: 0;
  }

  @media (max-width: 640px) {
    .site-footer {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    nav {
      flex-wrap: wrap;
      gap: 16px 24px;
    }
  }
</style>
