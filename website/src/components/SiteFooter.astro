---
const repositoryURL = "https://github.com/iamrajjoshi/mojipond";
const githubSHA = process.env.GITHUB_SHA?.trim();
const hasExactCommit = /^[0-9a-f]{40}$/i.test(githubSHA ?? "");
const commitURL = hasExactCommit
  ? `${repositoryURL}/commit/${githubSHA}`
  : `${repositoryURL}/commits/main`;
const commitLabel = hasExactCommit ? githubSHA?.slice(0, 7) : "main";

interface Props {
  inverse?: boolean;
}

const { inverse = false } = Astro.props;
---

<footer class:list={["site-footer", { inverse }]}>
  <a href={commitURL}>{commitLabel}</a>
</footer>

<style>
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 40px;
    padding: 10px 24px 14px;
    color: var(--ink-muted);
    font-size: 0.82rem;
  }

  .site-footer.inverse {
    color: rgb(235 255 251 / 70%);
    background: #06333d;
  }

  a {
    color: inherit;
    text-decoration-color: rgb(75 101 104 / 36%);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  a:hover {
    color: var(--pond);
    text-decoration-color: currentcolor;
  }

  .inverse a:hover {
    color: #f5fffd;
  }
</style>
