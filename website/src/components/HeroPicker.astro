---
import { emojiOptions, waveSuggestions } from "../lib/emojiOptions";
---

<div
  class="hero-demo-shell"
  data-hero-demo-shell
  data-options={JSON.stringify(emojiOptions)}
>
  <p class="sr-only" id="hero-demo-instructions">
    Interactive Messages demo. Type a colon and an emoji name, choose a result,
    then send the message.
  </p>

  <div
    class="messages-demo"
    data-hero-demo
    data-mode="auto"
    data-phase="picker"
  >
    <div class="window-bar" aria-hidden="true">
      <span class="traffic-lights"><i></i><i></i><i></i></span>
      <strong>Messages</strong>
      <span class="window-balance"></span>
    </div>

    <div class="conversation">
      <div class="contact" aria-hidden="true">
        <span class="avatar">A</span>
        <strong>Alex</strong>
        <small>iMessage</small>
      </div>

      <ol
        class="message-thread"
        aria-label="Conversation with Alex"
        data-message-thread
      >
        <li class="incoming-bubble" data-incoming-message hidden>
          Did that fix the emoji shortcut?
        </li>
        <li class="outgoing-bubble demo-message" data-demo-message hidden>
          Yep, that fixed it — thanks for checking 👋
        </li>
      </ol>

      <div class="hero-picker" data-picker>
        <div
          class="suggestions"
          id="hero-suggestions"
          role="listbox"
          aria-label="Emoji suggestions"
          data-shortcode-suggestions
        >
          {
            waveSuggestions.map((option, index) => (
              <button
                id={`hero-option-${option.shortcode}`}
                class:list={["suggestion", { selected: index === 0 }]}
                type="button"
                role="option"
                aria-selected={index === 0 ? "true" : "false"}
                tabindex="-1"
                data-option={option.shortcode}
              >
                <span class="emoji" aria-hidden="true">
                  {option.emoji}
                </span>
                <span class="suggestion-copy">
                  <strong>:{option.shortcode}:</strong>
                  <small>{option.name}</small>
                </span>
                <span class="selected-mark" aria-hidden="true">
                  ✓
                </span>
              </button>
            ))
          }
        </div>

        <div class="picker-keys" aria-hidden="true">
          <span><kbd>↑</kbd><kbd>↓</kbd> choose</span>
          <span class="accept-cue"
            ><kbd>Tab</kbd> or <kbd class="return-key">Return</kbd> insert</span
          >
          <span><kbd>Esc</kbd> close</span>
        </div>
      </div>

      <form class="composer-row" data-composer>
        <label class="composer-label" for="hero-message-input">Try it now</label
        >
        <div class="composer-field">
          <input
            id="hero-message-input"
            type="text"
            value="Yep, that fixed it — thanks for checking :wa"
            placeholder="iMessage"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            role="combobox"
            aria-label="Message"
            aria-autocomplete="list"
            aria-expanded="true"
            aria-controls="hero-suggestions"
            aria-activedescendant="hero-option-wave"
            aria-describedby="hero-demo-instructions"
            data-shortcode-input
          />
        </div>
        <button class="send-button" type="submit" aria-label="Send message">
          <span aria-hidden="true">↑</span>
        </button>
      </form>
    </div>
  </div>

  <p class="sr-only" aria-live="polite" data-shortcode-status></p>
</div>

<script>
  interface EmojiOption {
    shortcode: string;
    emoji: string;
    name: string;
    aliases: string[];
    keywords: string[];
  }

  interface ActiveToken {
    start: number;
    end: number;
    query: string;
    closed: boolean;
  }

  interface DemoFrame {
    value: string;
    phase:
      | "waiting"
      | "incoming"
      | "typing"
      | "picker"
      | "accepting"
      | "inserted"
      | "sent";
    delay: number;
  }

  const root = document.querySelector("[data-hero-demo-shell]");

  if (root instanceof HTMLElement) {
    const demo = root.querySelector("[data-hero-demo]");
    const form = root.querySelector("[data-composer]");
    const input = root.querySelector("[data-shortcode-input]");
    const picker = root.querySelector("[data-picker]");
    const listbox = root.querySelector("[data-shortcode-suggestions]");
    const status = root.querySelector("[data-shortcode-status]");
    const thread = root.querySelector("[data-message-thread]");
    const incomingMessage = root.querySelector("[data-incoming-message]");
    const demoMessage = root.querySelector("[data-demo-message]");
    const sendButton = root.querySelector(".send-button");
    const parsedOptions: unknown = JSON.parse(root.dataset.options ?? "[]");
    const options = Array.isArray(parsedOptions)
      ? (parsedOptions as EmojiOption[])
      : [];

    if (
      demo instanceof HTMLElement &&
      form instanceof HTMLFormElement &&
      input instanceof HTMLInputElement &&
      picker instanceof HTMLElement &&
      listbox instanceof HTMLElement &&
      status instanceof HTMLParagraphElement &&
      thread instanceof HTMLOListElement &&
      incomingMessage instanceof HTMLLIElement &&
      demoMessage instanceof HTMLLIElement &&
      sendButton instanceof HTMLButtonElement
    ) {
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const prefix = "Yep, that fixed it — thanks for checking ";
      const typingFrames: DemoFrame[] = Array.from(prefix, (_, index) => ({
        value: prefix.slice(0, index + 1),
        phase: "typing",
        delay: 85,
      }));
      const frames: DemoFrame[] = [
        { value: "", phase: "waiting", delay: 500 },
        { value: "", phase: "incoming", delay: 1_400 },
        ...typingFrames,
        { value: `${prefix}:`, phase: "typing", delay: 480 },
        { value: `${prefix}:w`, phase: "picker", delay: 500 },
        { value: `${prefix}:wa`, phase: "picker", delay: 500 },
        { value: `${prefix}:wav`, phase: "picker", delay: 500 },
        { value: `${prefix}:wave`, phase: "picker", delay: 700 },
        { value: `${prefix}:wave:`, phase: "accepting", delay: 900 },
        { value: `${prefix}👋`, phase: "inserted", delay: 1_800 },
        { value: "", phase: "sent", delay: 0 },
      ];
      const staticFrameIndex = frames.findIndex(
        (frame) => frame.phase === "picker" && frame.value.endsWith(":wa"),
      );

      let matches = options.slice(0, 5);
      let selectedIndex = 0;
      let activeToken: ActiveToken | null = null;
      let frameIndex = 0;
      let timer: number | undefined;
      let userControlled = false;
      let suspendedByVisibility = document.hidden;

      const clearTimer = () => {
        if (timer !== undefined) {
          window.clearTimeout(timer);
          timer = undefined;
        }
      };

      const findActiveToken = (): ActiveToken | null => {
        const caret = input.selectionStart ?? input.value.length;
        const beforeCaret = input.value.slice(0, caret);
        const match = beforeCaret.match(/(^|[\s([{\"'])(:[a-z0-9_+\-]*:?)$/i);
        if (!match) return null;

        const rawToken = match[2];
        const closed = rawToken.length > 1 && rawToken.endsWith(":");
        const suffix = closed
          ? ""
          : (input.value.slice(caret).match(/^[a-z0-9_+\-]*:?/i)?.[0] ?? "");
        const query = rawToken
          .slice(1, closed ? -1 : undefined)
          .toLocaleLowerCase();

        return {
          start: caret - rawToken.length,
          end: caret + suffix.length,
          query,
          closed,
        };
      };

      const matchScore = (option: EmojiOption, query: string) => {
        if (!query) return { tier: 0, length: option.shortcode.length };
        if (option.shortcode === query || option.aliases.includes(query)) {
          return { tier: 0, length: query.length };
        }
        if (option.shortcode.startsWith(query)) {
          return { tier: 1, length: option.shortcode.length };
        }
        const aliasPrefix = option.aliases
          .filter((alias) => alias.startsWith(query))
          .sort((left, right) => left.length - right.length)[0];
        if (aliasPrefix) {
          return { tier: 2, length: aliasPrefix.length };
        }

        const name = option.name.toLocaleLowerCase();
        if (name.startsWith(query)) return { tier: 3, length: name.length };
        const namePrefix = name
          .split(/\s+/)
          .filter((word) => word.startsWith(query))
          .sort((left, right) => left.length - right.length)[0];
        if (namePrefix) return { tier: 4, length: namePrefix.length };
        const keywordPrefix = option.keywords
          .filter((keyword) => keyword.startsWith(query))
          .sort((left, right) => left.length - right.length)[0];
        if (keywordPrefix) {
          return { tier: 5, length: keywordPrefix.length };
        }
        if (
          option.shortcode.includes(query) ||
          option.aliases.some((alias) => alias.includes(query))
        ) {
          return { tier: 6, length: option.shortcode.length };
        }
        if (name.includes(query)) return { tier: 7, length: name.length };
        const keywordMatch = option.keywords
          .filter((keyword) => keyword.includes(query))
          .sort((left, right) => left.length - right.length)[0];
        if (keywordMatch) return { tier: 8, length: keywordMatch.length };
        return null;
      };

      const matchingOptions = (query: string) =>
        options
          .map((option, index) => ({
            option,
            index,
            score: matchScore(option, query),
          }))
          .filter(
            (
              candidate,
            ): candidate is typeof candidate & {
              score: { tier: number; length: number };
            } => candidate.score !== null,
          )
          .sort(
            (left, right) =>
              left.score.tier - right.score.tier ||
              left.score.length - right.score.length ||
              left.index - right.index,
          )
          .slice(0, 5)
          .map((candidate) => candidate.option);

      const updateSendState = () => {
        sendButton.disabled = input.value.trim().length === 0;
      };

      const closeSuggestions = () => {
        matches = [];
        activeToken = null;
        picker.hidden = true;
        input.setAttribute("aria-expanded", "false");
        input.removeAttribute("aria-activedescendant");
      };

      const renderSuggestions = () => {
        if (matches.length === 0) {
          closeSuggestions();
          return;
        }

        const rows = matches.map((option, index) => {
          const row = document.createElement("button");
          const emoji = document.createElement("span");
          const copy = document.createElement("span");
          const shortcode = document.createElement("strong");
          const name = document.createElement("small");
          const selectedMark = document.createElement("span");
          const isSelected = index === selectedIndex;

          row.id = `hero-option-${option.shortcode}`;
          row.className = `suggestion${isSelected ? " selected" : ""}`;
          row.type = "button";
          row.tabIndex = -1;
          row.setAttribute("role", "option");
          row.setAttribute("aria-selected", String(isSelected));
          row.dataset.option = option.shortcode;

          emoji.className = "emoji";
          emoji.setAttribute("aria-hidden", "true");
          emoji.textContent = option.emoji;

          copy.className = "suggestion-copy";
          shortcode.textContent = `:${option.shortcode}:`;
          name.textContent = option.name;
          copy.append(shortcode, name);

          selectedMark.className = "selected-mark";
          selectedMark.setAttribute("aria-hidden", "true");
          selectedMark.textContent = "✓";

          row.append(emoji, copy, selectedMark);
          return row;
        });

        listbox.replaceChildren(...rows);
        picker.hidden = false;
        input.setAttribute("aria-expanded", "true");
        input.setAttribute("aria-activedescendant", rows[selectedIndex].id);
      };

      const insertOption = (option: EmojiOption) => {
        if (!activeToken) return;

        input.setRangeText(
          option.emoji,
          activeToken.start,
          activeToken.end,
          "end",
        );
        closeSuggestions();
        updateSendState();
        if (userControlled) {
          status.textContent = `Inserted ${option.name}.`;
          input.focus();
        }
        input.dispatchEvent(new Event("change", { bubbles: true }));
      };

      const updateSuggestions = () => {
        activeToken = findActiveToken();
        if (!activeToken) {
          closeSuggestions();
          updateSendState();
          return;
        }

        if (activeToken.closed) {
          const exactMatch = options.find((option) =>
            option.aliases.includes(activeToken?.query ?? ""),
          );
          if (exactMatch) {
            insertOption(exactMatch);
            return;
          }
        }

        matches = matchingOptions(activeToken.query);
        selectedIndex = 0;
        renderSuggestions();
        updateSendState();
        if (userControlled) {
          status.textContent =
            matches.length === 0
              ? "No emoji suggestions."
              : `${matches.length} emoji suggestion${matches.length === 1 ? "" : "s"}.`;
        }
      };

      const moveSelection = (offset: number) => {
        selectedIndex =
          (selectedIndex + offset + matches.length) % matches.length;
        renderSuggestions();
        const selected = matches[selectedIndex];
        status.textContent = `${selected.name}, ${selectedIndex + 1} of ${matches.length}.`;
        document
          .getElementById(`hero-option-${selected.shortcode}`)
          ?.scrollIntoView({ block: "nearest" });
      };

      const takeControl = () => {
        if (userControlled) return;

        const completedDemo = demo.dataset.phase === "sent";
        userControlled = true;
        suspendedByVisibility = false;
        clearTimer();
        demo.dataset.mode = "interactive";
        demo.dataset.phase = "typing";
        incomingMessage.hidden = false;
        demoMessage.hidden = !completedDemo;
      };

      const sendMessage = () => {
        const message = input.value.trim();
        if (!message) return;

        const bubble = document.createElement("li");
        bubble.className = "outgoing-bubble user-message";
        bubble.dataset.userMessage = "";
        bubble.textContent = message;
        thread.append(bubble);

        input.value = "";
        closeSuggestions();
        updateSendState();
        status.textContent = "Message sent.";
        input.focus();
        window.requestAnimationFrame(() => {
          thread.scrollTop = thread.scrollHeight;
        });
      };

      const renderFrame = (frame: DemoFrame) => {
        input.value = frame.value;
        input.setSelectionRange(input.value.length, input.value.length);
        demo.dataset.phase = frame.phase;
        incomingMessage.hidden = frame.phase === "waiting";
        demoMessage.hidden = frame.phase !== "sent";

        if (frame.phase === "picker" || frame.phase === "accepting") {
          activeToken = findActiveToken();
          matches = matchingOptions(activeToken?.query ?? "");
          selectedIndex = 0;
          renderSuggestions();
        } else {
          closeSuggestions();
        }
        updateSendState();
      };

      const schedule = () => {
        if (userControlled || reducedMotion.matches) {
          return;
        }

        const frame = frames[frameIndex];
        renderFrame(frame);
        if (suspendedByVisibility) return;
        if (frameIndex === frames.length - 1) {
          demo.dataset.mode = "complete";
          return;
        }
        timer = window.setTimeout(() => {
          frameIndex += 1;
          schedule();
        }, frame.delay);
      };

      const startAuto = (initialFrame = 0) => {
        clearTimer();
        demo.dataset.mode = "auto";
        frameIndex = initialFrame;
        schedule();
      };

      const showStaticFrame = () => {
        clearTimer();
        demo.dataset.mode = "static";
        frameIndex = staticFrameIndex;
        renderFrame(frames[frameIndex]);
      };

      input.addEventListener("input", () => {
        takeControl();
        updateSuggestions();
      });
      input.addEventListener("click", () => {
        takeControl();
        updateSuggestions();
      });
      input.addEventListener("select", updateSuggestions);

      document.addEventListener("selectionchange", () => {
        if (userControlled && document.activeElement === input) {
          updateSuggestions();
        }
      });

      input.addEventListener("keydown", (event) => {
        if (
          matches.length === 0 ||
          input.getAttribute("aria-expanded") !== "true"
        ) {
          return;
        }

        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          moveSelection(event.key === "ArrowDown" ? 1 : -1);
          return;
        }

        if (event.key === "Tab" || event.key === "Enter") {
          event.preventDefault();
          insertOption(matches[selectedIndex]);
          return;
        }

        if (event.key === "Escape") {
          event.preventDefault();
          closeSuggestions();
          status.textContent = "Suggestions closed.";
        }
      });

      listbox.addEventListener("pointerdown", (event) => {
        takeControl();
        event.preventDefault();
      });
      listbox.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const row = target.closest<HTMLElement>("[data-option]");
        const option = options.find(
          (candidate) => candidate.shortcode === row?.dataset.option,
        );
        if (option) insertOption(option);
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        takeControl();
        if (
          matches.length > 0 &&
          input.getAttribute("aria-expanded") === "true"
        ) {
          insertOption(matches[selectedIndex]);
        }
        sendMessage();
      });

      reducedMotion.addEventListener("change", () => {
        if (userControlled) return;
        if (reducedMotion.matches) {
          showStaticFrame();
        } else {
          startAuto();
        }
      });

      document.addEventListener("visibilitychange", () => {
        if (userControlled || reducedMotion.matches) return;
        if (document.hidden) {
          suspendedByVisibility = true;
          clearTimer();
          return;
        }
        if (suspendedByVisibility) {
          suspendedByVisibility = false;
          schedule();
        }
      });

      if (reducedMotion.matches) {
        showStaticFrame();
      } else {
        startAuto();
      }
    }
  }
</script>

<style>
  .hero-demo-shell {
    width: 100%;
  }

  .messages-demo {
    width: 100%;
    overflow: hidden;
    color: #202124;
    background: rgb(250 252 251 / 97%);
    border: 1px solid rgb(218 244 240 / 52%);
    border-radius: 26px;
    box-shadow:
      0 34px 100px rgb(0 15 20 / 42%),
      inset 0 1px rgb(255 255 255 / 82%);
    backdrop-filter: blur(24px) saturate(1.08);
  }

  .window-bar {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr) 84px;
    min-height: 50px;
    padding: 0 16px;
    align-items: center;
    color: #33484d;
    font-size: 0.82rem;
    background: rgb(239 243 242 / 94%);
    border-bottom: 1px solid rgb(6 51 61 / 10%);
  }

  .window-bar > strong {
    font-weight: 680;
    text-align: center;
  }

  .traffic-lights {
    display: flex;
    gap: 8px;
  }

  .traffic-lights i {
    display: block;
    width: 11px;
    height: 11px;
    background: #ff5f57;
    border: 1px solid rgb(0 0 0 / 8%);
    border-radius: 50%;
  }

  .traffic-lights i:nth-child(2) {
    background: #febc2e;
  }

  .traffic-lights i:nth-child(3) {
    background: #28c840;
  }

  .conversation {
    display: flex;
    min-height: 526px;
    padding: 14px 18px 18px;
    flex-direction: column;
    background: linear-gradient(180deg, #fbfcfc, #fff);
  }

  .contact {
    display: grid;
    gap: 1px;
    margin-bottom: 10px;
    justify-items: center;
    color: #61666b;
    font-size: 0.7rem;
    line-height: 1.1;
  }

  .contact strong {
    margin-top: 2px;
    color: #303438;
    font-size: 0.75rem;
  }

  .contact small {
    color: #8b9095;
    font-size: 0.62rem;
  }

  .avatar {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    color: white;
    font-size: 0.78rem;
    font-weight: 700;
    background: linear-gradient(145deg, #f08b72, #cc4f65);
    border-radius: 50%;
  }

  .message-thread {
    display: flex;
    min-height: 70px;
    max-height: 126px;
    padding: 2px 0 12px;
    margin: 0;
    overflow-y: auto;
    flex-direction: column;
    gap: 8px;
    list-style: none;
    scrollbar-width: thin;
  }

  .incoming-bubble,
  .outgoing-bubble,
  :global(.user-message) {
    width: max-content;
    max-width: min(78%, 520px);
    padding: 8px 12px;
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.25;
  }

  .incoming-bubble {
    align-self: flex-start;
    color: #1f2526;
    background: #e9e9ee;
    border-radius: 15px 15px 15px 5px;
  }

  .outgoing-bubble,
  :global(.user-message) {
    align-self: flex-end;
    color: white;
    background: #0a84ff;
    border-radius: 15px 15px 5px;
  }

  .hero-picker {
    width: 100%;
    margin-bottom: 12px;
    overflow: hidden;
    background: rgb(255 255 255 / 99%);
    border: 1px solid rgb(6 51 61 / 16%);
    border-radius: 16px;
    box-shadow: 0 16px 40px rgb(6 51 61 / 16%);
  }

  .suggestions {
    display: grid;
    gap: 2px;
    padding: 5px;
  }

  .suggestions :global(.suggestion) {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 20px;
    gap: 10px;
    width: 100%;
    min-height: 48px;
    padding: 4px 10px;
    align-items: center;
    color: var(--deep-water);
    font: inherit;
    text-align: left;
    background: transparent;
    border: 0;
    border-radius: 11px;
    cursor: pointer;
  }

  .suggestions :global(.suggestion:hover:not(.selected)) {
    background: #edf3f1;
  }

  .suggestions :global(.suggestion.selected) {
    color: white;
    background: var(--deep-water);
  }

  .suggestions :global(.emoji) {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    font-family: system-ui, sans-serif;
    font-size: 1.45rem;
    background: rgb(255 255 255 / 86%);
    border: 1px solid rgb(6 51 61 / 8%);
    border-radius: 10px;
  }

  .suggestions :global(.suggestion-copy) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .suggestions :global(.suggestion-copy strong) {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .suggestions :global(.suggestion-copy small) {
    overflow: hidden;
    color: #617174;
    font-size: 0.75rem;
    line-height: 1.05;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .suggestions :global(.selected .suggestion-copy small) {
    color: #cfe4e2;
  }

  .suggestions :global(.selected-mark) {
    visibility: hidden;
    font-size: 0.8rem;
    font-weight: 750;
    text-align: center;
  }

  .suggestions :global(.selected .selected-mark) {
    visibility: visible;
  }

  .picker-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 16px;
    min-height: 34px;
    padding: 7px 12px;
    align-items: center;
    color: #69797c;
    font-size: 0.68rem;
    font-weight: 650;
    background: #eef3f1;
    border-top: 1px solid rgb(6 51 61 / 9%);
  }

  .picker-keys span {
    white-space: nowrap;
  }

  kbd {
    display: inline-grid;
    min-width: 26px;
    min-height: 19px;
    padding: 1px 5px;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    background: white;
    border: 1px solid rgb(6 51 61 / 18%);
    border-radius: 5px;
    box-shadow: 0 1px rgb(6 51 61 / 12%);
    transition:
      color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .composer-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 42px;
    column-gap: 9px;
    row-gap: 4px;
    margin-top: auto;
