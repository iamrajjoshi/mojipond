---
import { waveSuggestions } from "../lib/emojiOptions";
---

<div class="hero-demo-shell" data-hero-demo-shell>
  <p class="sr-only">
    Demo: type colon wave, choose Waving hand, and press Tab to replace the
    shortcut.
  </p>

  <div
    class="messages-demo"
    data-hero-demo
    data-phase="picker"
    aria-hidden="true"
  >
    <div class="window-bar">
      <span class="traffic-lights">
        <i></i><i></i><i></i>
      </span>
      <strong>Messages</strong>
      <span class="window-balance"></span>
    </div>

    <div class="conversation">
      <div class="contact">
        <span class="avatar">A</span>
        <span>Alex</span>
      </div>
      <p class="incoming-bubble">Did that fix it?</p>

      <figure class="hero-picker">
        <ul>
          {
            waveSuggestions.map((suggestion, index) => (
              <li class:list={{ selected: index === 0 }}>
                <span class="emoji">{suggestion.emoji}</span>
                <span class="copy">
                  <strong>:{suggestion.shortcode}:</strong>
                  <small>{suggestion.name}</small>
                </span>
                <span class="check">{index === 0 ? "✓" : ""}</span>
              </li>
            ))
          }
        </ul>
        <figcaption>
          <span>↑↓ choose</span>
          <span class="accept-cue"><kbd>Tab</kbd> insert</span>
          <span>Esc close</span>
        </figcaption>
      </figure>

      <div class="composer-row">
        <div class="composer-field">
          <span>That fixed it </span><strong data-demo-token>:wa</strong><i
            class="caret"></i>
        </div>
        <span class="send-button">↑</span>
      </div>
    </div>
  </div>

  <button class="motion-toggle" type="button" data-hero-toggle>
    <span class="toggle-icon" aria-hidden="true">Ⅱ</span>
    <span data-toggle-label>Pause demo</span>
  </button>
</div>

<script>
  interface DemoFrame {
    token: string;
    phase: "typing" | "picker" | "accepting" | "inserted";
    delay: number;
  }

  const shell = document.querySelector<HTMLElement>("[data-hero-demo-shell]");

  if (shell) {
    const demo = shell.querySelector<HTMLElement>("[data-hero-demo]");
    const token = shell.querySelector<HTMLElement>("[data-demo-token]");
    const toggle = shell.querySelector<HTMLButtonElement>("[data-hero-toggle]");
    const toggleLabel = shell.querySelector<HTMLElement>("[data-toggle-label]");
    const toggleIcon = shell.querySelector<HTMLElement>(".toggle-icon");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const frames: DemoFrame[] = [
      { token: "", phase: "typing", delay: 560 },
      { token: ":", phase: "typing", delay: 170 },
      { token: ":w", phase: "typing", delay: 220 },
      { token: ":wa", phase: "picker", delay: 1_000 },
      { token: ":wa", phase: "accepting", delay: 460 },
      { token: "👋", phase: "inserted", delay: 1_700 },
    ];

    if (demo && token && toggle && toggleLabel && toggleIcon) {
      let frameIndex = 0;
      let timer: number | undefined;
      let paused = reducedMotion.matches;
      let playOnce = false;
      let completed = false;
      let suspendedByVisibility = false;

      const clearTimer = () => {
        if (timer !== undefined) {
          window.clearTimeout(timer);
          timer = undefined;
        }
      };

      const updateControl = () => {
        toggleLabel.textContent = paused
          ? completed
            ? "Replay demo"
            : "Play demo"
          : "Pause demo";
        toggleIcon.textContent = paused ? "▶" : "Ⅱ";
      };

      const render = (frame: DemoFrame) => {
        token.textContent = frame.token;
        demo.dataset.phase = frame.phase;
      };

      const showStaticFrame = () => {
        clearTimer();
        paused = true;
        completed = false;
        frameIndex = 3;
        render(frames[frameIndex]);
        updateControl();
      };

      const schedule = () => {
        if (paused || suspendedByVisibility) return;

        const frame = frames[frameIndex];
        render(frame);
        timer = window.setTimeout(() => {
          frameIndex += 1;
          if (frameIndex >= frames.length) {
            if (playOnce) {
              paused = true;
              completed = true;
              playOnce = false;
              frameIndex = frames.length - 1;
              updateControl();
              return;
            }
            frameIndex = 0;
          }
          schedule();
        }, frame.delay);
      };

      const start = (once = false, initialFrame = 0) => {
        clearTimer();
        paused = false;
        playOnce = once;
        completed = false;
        frameIndex = initialFrame;
        updateControl();
        schedule();
      };

      const stop = () => {
        clearTimer();
        paused = true;
        completed = false;
        updateControl();
      };

      toggle.addEventListener("click", () => {
        if (paused) {
          start(reducedMotion.matches);
        } else {
          stop();
        }
      });

      reducedMotion.addEventListener("change", () => {
        if (reducedMotion.matches) {
          showStaticFrame();
        } else {
          start();
        }
      });

      document.addEventListener("visibilitychange", () => {
        if (document.hidden && !paused) {
          suspendedByVisibility = true;
          clearTimer();
          return;
        }
        if (!document.hidden && suspendedByVisibility) {
          suspendedByVisibility = false;
          schedule();
        }
      });

      if (reducedMotion.matches) {
        showStaticFrame();
      } else {
        start(false, 3);
      }
    }
  }
</script>

<style>
  .hero-demo-shell {
    display: grid;
    width: 100%;
    justify-items: center;
  }

  .messages-demo {
    width: 100%;
    overflow: hidden;
    color: #172d32;
    background: rgb(250 252 251 / 96%);
    border: 1px solid rgb(207 241 236 / 42%);
    border-radius: 22px;
    box-shadow:
      0 28px 80px rgb(0 15 20 / 38%),
      inset 0 1px rgb(255 255 255 / 76%);
    backdrop-filter: blur(22px) saturate(1.08);
  }

  .window-bar {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) 76px;
    min-height: 46px;
    padding: 0 14px;
    align-items: center;
    color: #29474c;
    font-size: 0.78rem;
    background: rgb(235 241 239 / 88%);
    border-bottom: 1px solid rgb(6 51 61 / 10%);
  }

  .window-bar > strong {
    font-family: var(--font-display);
    font-weight: 650;
    text-align: center;
  }

  .traffic-lights {
    display: flex;
    gap: 7px;
  }

  .traffic-lights i {
    display: block;
    width: 10px;
    height: 10px;
    background: #ff5f57;
    border: 1px solid rgb(0 0 0 / 8%);
    border-radius: 50%;
  }

  .traffic-lights i:nth-child(2) {
    background: #febc2e;
  }

  .traffic-lights i:nth-child(3) {
    background: #28c840;
  }

  .conversation {
    padding: 12px;
    background: linear-gradient(180deg, #f8faf9, #fff);
  }

  .contact {
    display: grid;
    gap: 4px;
    margin-bottom: 8px;
    justify-items: center;
    color: #66777a;
    font-size: 0.68rem;
    font-weight: 650;
  }

  .avatar {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    color: white;
    background: linear-gradient(145deg, #f08b72, #cc4f65);
    border-radius: 50%;
  }

  .incoming-bubble {
    width: max-content;
    max-width: 70%;
    padding: 7px 11px;
    margin: 0 0 9px;
    color: #1f2526;
    font-size: 0.82rem;
    line-height: 1.2;
    background: #e8e8ed;
    border-radius: 13px 13px 13px 4px;
  }

  .hero-picker {
    width: 100%;
    margin: 0 0 10px;
    overflow: hidden;
    background: rgb(255 255 255 / 98%);
    border: 1px solid rgb(6 51 61 / 16%);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgb(6 51 61 / 14%);
    transform: translateY(0) scale(1);
    transition:
      opacity 220ms ease,
      transform 220ms ease;
  }

  ul {
    display: grid;
    gap: 1px;
    padding: 4px;
    margin: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) 18px;
    gap: 8px;
    min-height: 42px;
    padding: 4px 8px;
    align-items: center;
    border-radius: 8px;
  }

  li.selected {
    color: white;
    background: var(--deep-water);
  }

  .emoji {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    font-family: system-ui, sans-serif;
    font-size: 1.3rem;
    background: rgb(255 255 255 / 84%);
    border: 1px solid rgb(6 51 61 / 9%);
    border-radius: 8px;
  }

  .copy {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .copy strong {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy small {
    overflow: hidden;
    color: #617174;
    font-size: 0.7rem;
    line-height: 1.05;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .selected .copy small {
    color: #cfe4e2;
  }

  .check {
    font-size: 0.8rem;
    font-weight: 750;
    text-align: center;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 13px;
    min-height: 28px;
    padding: 6px 10px;
    align-items: center;
    color: #627477;
    font-size: 0.64rem;
    font-weight: 650;
    background: #eef3f1;
    border-top: 1px solid rgb(6 51 61 / 9%);
  }

  figcaption span {
    white-space: nowrap;
  }

  kbd {
    display: inline-grid;
    min-width: 27px;
    min-height: 18px;
    padding: 1px 5px;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    background: white;
    border: 1px solid rgb(6 51 61 / 18%);
    border-radius: 4px;
    box-shadow: 0 1px rgb(6 51 61 / 12%);
    transition:
      color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .composer-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 32px;
    gap: 8px;
    align-items: center;
  }

  .composer-field {
    display: flex;
    min-height: 36px;
    padding: 7px 12px;
    align-items: center;
    color: #202728;
    font-size: 0.82rem;
    background: white;
    border: 1px solid #d8ddde;
    border-radius: 18px;
  }

  .composer-field > strong {
    color: var(--pond);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .caret {
    width: 1px;
    height: 17px;
    margin-left: 1px;
    background: #1988a1;
    animation: caret-blink 900ms steps(1) infinite;
  }

  .send-button {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    color: white;
    font-size: 1rem;
    font-weight: 750;
    background: #0a84ff;
    border-radius: 50%;
  }

  [data-phase="typing"] .hero-picker {
    visibility: hidden;
    opacity: 0;
    transform: translateY(6px) scale(0.985);
  }

  [data-phase="accepting"] .accept-cue kbd {
    color: white;
    background: var(--lotus);
    transform: translateY(1px) scale(0.94);
  }

  [data-phase="inserted"] .hero-picker {
    visibility: hidden;
    opacity: 0;
    transform: translateY(6px) scale(0.985);
  }

  [data-phase="inserted"] .composer-field > strong {
    color: inherit;
    font-family: system-ui, sans-serif;
    font-size: 1rem;
  }

  .motion-toggle {
    display: inline-flex;
    gap: 7px;
    min-height: 32px;
    padding: 6px 10px;
    margin-top: 10px;
    align-items: center;
    color: rgb(235 251 248 / 88%);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 650;
    background: rgb(2 31 38 / 58%);
    border: 1px solid rgb(190 241 233 / 22%);
    border-radius: 999px;
    cursor: pointer;
    backdrop-filter: blur(14px);
  }

  .motion-toggle:hover {
    color: white;
    background: rgb(5 49 57 / 82%);
  }

  .toggle-icon {
    width: 12px;
    font-size: 0.65rem;
    text-align: center;
  }

  @keyframes caret-blink {
    0%,
    45% {
      opacity: 1;
    }

    46%,
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 520px) {
    .messages-demo {
      border-radius: 18px;
    }

    .window-bar {
      grid-template-columns: 64px minmax(0, 1fr) 64px;
      min-height: 42px;
      padding-inline: 10px;
    }

    .conversation {
      padding: 8px;
    }

    .contact {
      margin-bottom: 6px;
    }

    .incoming-bubble {
      margin-bottom: 7px;
    }

    li {
      grid-template-columns: 32px minmax(0, 1fr) 16px;
      gap: 7px;
      min-height: 40px;
      padding-inline: 6px;
    }

    .emoji {
      width: 30px;
      height: 30px;
      font-size: 1.15rem;
    }

    figcaption {
      gap: 5px 10px;
      padding-inline: 8px;
    }
  }
</style>
