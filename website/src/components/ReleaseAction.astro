<div class="release-action" data-release-action>
  <span class="release-pending" data-release-fallback>
    Mac app in final testing.
  </span>
  <a
    class="button primary"
    href="/releases/MojiPond.dmg"
    download
    hidden
    data-release-download
  >
    Download for Mac
  </a>
  <span class="release-detail" hidden data-release-detail></span>
</div>

<script>
  import { parseReleaseManifest } from "../lib/releaseManifest";

  const formatBytes = (value: number) => {
    const megabytes = value / 1_048_576;
    return `${megabytes.toFixed(megabytes >= 10 ? 0 : 1)} MB`;
  };

  const revealRelease = async () => {
    const action = document.querySelector("[data-release-action]");
    if (!(action instanceof HTMLElement)) return;

    try {
      const response = await fetch("/releases/release.json", {
        cache: "no-store",
        credentials: "omit",
      });
      if (!response.ok) {
        if (response.status !== 404) {
          console.warn(`Release metadata request failed: ${response.status}`);
        }
        return;
      }

      const payload: unknown = await response.json();
      const release = parseReleaseManifest(payload);
      if (!release) {
        console.warn("Release metadata has an invalid shape.");
        return;
      }

      const fallback = action.querySelector("[data-release-fallback]");
      const download = action.querySelector("[data-release-download]");
      const detail = action.querySelector("[data-release-detail]");
      if (
        !(fallback instanceof HTMLSpanElement) ||
        !(download instanceof HTMLAnchorElement) ||
        !(detail instanceof HTMLSpanElement)
      ) {
        return;
      }

      fallback.setAttribute("hidden", "");
      download.removeAttribute("hidden");
      detail.textContent = `Version ${release.version} · ${formatBytes(release.asset.byteCount)} · macOS 14 or newer`;
      detail.removeAttribute("hidden");
    } catch (error) {
      console.warn("Release metadata could not be loaded.", error);
    }
  };

  void revealRelease();
</script>

<style>
  .release-action {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    align-items: center;
  }

  .release-pending,
  .release-detail {
    color: var(--ink-muted);
    font-size: 0.88rem;
    font-weight: 650;
  }
</style>
