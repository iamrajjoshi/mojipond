---
import { Image } from "astro:assets";
import caretSuggestions from "../../../docs/screenshots/caret-suggestions.png";
import emojiBrowser from "../../../docs/screenshots/emoji-browser-dark.png";
import importPreview from "../../../docs/screenshots/import-preview.png";
import library from "../../../docs/screenshots/library.png";
import PondScene from "../components/PondScene.astro";
import ReleaseAction from "../components/ReleaseAction.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "MojiPond — :emoji: autocomplete and custom packs for macOS";
const description =
  "Type :emoji: shortcuts beside the caret on macOS. MojiPond includes Unicode emoji and custom packs imported from ZIP.";

const faqItems = [
  {
    question: "Where does it work?",
    answer:
      "Unicode shortcuts work in supported macOS text fields. MojiPond stays out of password fields, terminals, remote desktop apps, Slack, Discord, and apps or sites you exclude. Custom image insertion works only in Messages.",
  },
  {
    question: "Why does it need macOS permissions?",
    answer:
      "Input Monitoring detects a shortcut; Accessibility finds the caret and replaces the token. Event Posting is optional and only needed for image insertion or send-after-insert in Messages.",
  },
  {
    question: "What ZIP files can I import?",
    answer:
      "Import one ZIP containing PNG, JPEG, GIF, or WebP files, or a Slack-style emoji.json file with local artwork. MojiPond shows naming conflicts before installing the pack.",
  },
  {
    question: "What happens to animated emoji?",
    answer:
      "The original file stays in your library. Messages inserts its first frame so the image can scale with nearby text.",
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="hero" aria-labelledby="hero-title">
    <PondScene />
    <div class="hero-wash" aria-hidden="true"></div>
    <div class="hero-copy">
      <span class="hero-token shortcode">:emoji:</span>
      <h1 id="hero-title">
        Your emoji,<br /><em>one colon away.</em>
      </h1>
      <p>
        Type <code>:wave:</code>, choose with the arrow keys, and keep writing.
        Use the built-in Unicode catalog or import your own pack from ZIP.
      </p>
      <ReleaseAction />
      <span class="hero-fact"
        >Native macOS app. No account or typing analytics.</span
      >
    </div>

    <figure class="hero-picker">
      <Image
        src={caretSuggestions}
        alt="MojiPond suggestions beside a typed frog shortcode, with Frog selected"
        width={760}
        height={558}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section
    class="autocomplete section-shell"
    id="how-it-works"
    aria-labelledby="autocomplete-title"
  >
    <div class="section-copy">
      <h2 id="autocomplete-title">The picker stays with your text.</h2>
      <p>
        Start with a colon, move through the results with the arrow keys, then
        press Tab or Return. Type <code>::</code> when you want the full browser.
      </p>
    </div>

    <ol class="key-flow" aria-label="How to insert an emoji">
      <li><code>:wa</code><span>Start typing</span></li>
      <li><kbd>↑</kbd><kbd>↓</kbd><span>Pick one</span></li>
      <li><kbd>Tab</kbd><span>Insert</span></li>
    </ol>

    <figure class="product-shot browser-shot">
      <Image
        src={emojiBrowser}
        alt="MojiPond's searchable emoji browser in dark appearance"
        width={880}
        height={642}
      />
    </figure>
  </section>

  <section class="packs" id="packs" aria-labelledby="packs-title">
    <div class="section-shell">
      <div class="section-copy packs-copy">
        <h2 id="packs-title">Bring your own emoji.</h2>
        <p>
          Import a ZIP containing PNG, JPEG, GIF, or WebP files. MojiPond reads
          Slack-style <code>emoji.json</code> aliases and shows naming conflicts before
          it installs the pack.
        </p>
      </div>

      <div class="pack-shots">
        <figure class="product-shot">
          <Image
            src={library}
            alt="The MojiPond library showing built-in emoji and an imported custom pack"
            width={920}
            height={672}
          />
          <figcaption>Browse built-in and imported emoji together.</figcaption>
        </figure>
        <figure class="product-shot">
          <Image
            src={importPreview}
            alt="MojiPond reviewing an emoji ZIP before installation"
            width={760}
            height={592}
          />
          <figcaption>
            Review names and collisions before installing.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="privacy" id="privacy" aria-labelledby="privacy-title">
    <div class="privacy-inner section-shell">
      <h2 id="privacy-title">Your typing stays on your Mac.</h2>
      <div>
        <p>
          MojiPond watches only for an active shortcode. It doesn't log keys,
          read your Messages database, create an account, or send app telemetry.
        </p>
        <a href="/privacy/">Read what each macOS permission does</a>
      </div>
    </div>
  </section>

  <section class="faq" id="faq" aria-labelledby="faq-title">
    <div class="faq-inner section-shell">
      <h2 id="faq-title">Questions before installing</h2>
      <div class="faq-list">
        {
          faqItems.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    width: min(calc(100% - 24px), 1540px);
    height: calc(100svh - 24px);
    min-height: 840px;
    max-height: 980px;
    margin: 12px auto 0;
    overflow: hidden;
    background: #d9efec;
    border-radius: 28px;
    isolation: isolate;
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgb(255 253 247 / 28%) 0,
      rgb(255 253 247 / 10%) 42%,
      transparent 66%
    );
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(calc(100% - 40px), 760px);
    padding-top: 146px;
    margin: 0 auto;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .hero-token {
    display: inline-flex;
    padding: 7px 11px;
    margin-bottom: 16px;
    color: var(--navy);
    font-size: 0.88rem;
    font-weight: 700;
    background: rgb(255 253 247 / 84%);
    border: 1px solid rgb(8 47 54 / 10%);
    border-radius: 9px;
  }

  .hero h1 {
    margin-bottom: 20px;
    color: var(--navy);
  }

  .hero h1 em {
    color: var(--teal);
    font-weight: 430;
  }

  .hero-copy > p {
    max-width: 620px;
    margin-bottom: 16px;
    color: #315256;
    font-size: 1.08rem;
  }

  .hero-copy :global(.release-action) {
    justify-content: center;
    margin-top: 2px;
  }

  .hero-fact {
    margin-top: 14px;
    color: #456367;
    font-size: 0.8rem;
    font-weight: 620;
  }

  .hero-picker {
    position: absolute;
    bottom: -52px;
    left: 50%;
    z-index: 3;
    width: min(calc(100% - 48px), 570px);
    margin: 0;
    overflow: hidden;
    background: var(--paper-strong);
    border: 1px solid rgb(8 47 54 / 15%);
    border-radius: 18px;
    box-shadow: 0 36px 90px rgb(6 44 50 / 27%);
    transform: translateX(-50%);
  }

  .hero-picker img,
  .product-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .autocomplete {
    padding: 124px 0 132px;
  }

  .section-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: 80px;
    align-items: end;
    margin-bottom: 64px;
  }

  .section-copy h2,
  .section-copy p {
    margin-bottom: 0;
  }

  .section-copy p {
    color: var(--ink-muted);
    font-size: 1.04rem;
  }

  .key-flow {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 0;
    margin: 0 0 40px;
    list-style: none;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .key-flow li {
    display: flex;
    gap: 7px;
    min-height: 70px;
    padding: 18px 24px;
    align-items: center;
  }

  .key-flow li + li {
    border-left: 1px solid var(--line);
  }

  .key-flow code,
  .key-flow kbd {
    color: var(--navy);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .key-flow kbd {
    min-width: 28px;
    padding: 4px 6px;
    text-align: center;
    background: var(--paper-strong);
    border: 1px solid var(--line);
    border-radius: 6px;
    box-shadow: 0 1px 0 rgb(8 47 54 / 14%);
  }

  .key-flow span {
    margin-left: auto;
    color: var(--ink-muted);
    font-size: 0.86rem;
  }

  .product-shot {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: var(--soft-shadow);
  }

  .browser-shot {
    width: min(980px, 100%);
    margin: 0 auto;
    background: #071f23;
  }

  .packs {
    padding: 120px 0 128px;
    color: #f5f3eb;
    background: var(--navy);
  }

  .packs-copy {
    margin-bottom: 56px;
  }

  .packs-copy p {
    color: #bfd0ce;
  }

  .packs-copy code {
    color: white;
  }

  .pack-shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .pack-shots .product-shot {
    background: #152f33;
    border-color: rgb(255 255 255 / 13%);
    box-shadow: 0 28px 72px rgb(0 17 20 / 30%);
  }

  .pack-shots figcaption {
    padding: 14px 16px 15px;
    color: #b9cfcc;
    font-size: 0.82rem;
  }

  .privacy {
    padding: 112px 0;
    background: var(--mist);
  }

  .privacy-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
    gap: 88px;
    align-items: center;
  }

  .privacy h2 {
    margin: 0;
  }

  .privacy p {
    margin-bottom: 18px;
    color: var(--ink-muted);
    font-size: 1.04rem;
  }

  .privacy a {
    color: var(--teal);
    font-weight: 720;
    text-underline-offset: 4px;
  }

  .faq {
    padding: 120px 0 64px;
  }

  .faq-inner > h2 {
    max-width: 620px;
    margin-bottom: 56px;
  }

  .faq-list {
    border-top: 1px solid var(--line);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    position: relative;
    padding: 24px 46px 24px 0;
    color: var(--navy);
    font-weight: 730;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    position: absolute;
    top: 19px;
    right: 0;
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    content: "+";
    color: var(--teal);
    font-size: 1.15rem;
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  details[open] summary::after {
    content: "−";
  }

  details p {
    max-width: 760px;
    padding: 0 48px 24px 0;
    margin: 0;
    color: var(--ink-muted);
  }

  @media (max-width: 820px) {
    .section-copy,
    .privacy-inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .section-copy {
      margin-bottom: 44px;
    }

    .key-flow li {
      padding-inline: 16px;
    }

    .key-flow span {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .hero {
      width: calc(100% - 16px);
      height: 980px;
      min-height: 0;
      margin-top: 8px;
      border-radius: 22px;
    }

    .hero-wash {
      background: linear-gradient(
        180deg,
        rgb(255 253 247 / 24%) 0,
        rgb(255 253 247 / 8%) 48%,
        transparent 72%
      );
    }

    .hero-copy {
      width: calc(100% - 32px);
      padding-top: 104px;
    }

    .hero-token {
      margin-bottom: 12px;
    }

    .hero h1 {
      margin-bottom: 18px;
    }

    .hero-copy > p {
      max-width: 480px;
      font-size: 0.98rem;
    }

    .hero-fact {
      max-width: 290px;
    }

    .hero-picker {
      bottom: 36px;
      width: calc(100% - 28px);
      border-radius: 14px;
      box-shadow: 0 28px 70px rgb(6 44 50 / 24%);
    }

    .autocomplete,
    .packs,
    .privacy,
    .faq {
      padding-top: 82px;
      padding-bottom: 88px;
    }

    .key-flow {
      grid-template-columns: 1fr;
    }

    .key-flow li {
      justify-content: center;
    }

    .key-flow li + li {
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .pack-shots {
      grid-template-columns: 1fr;
    }

    .privacy-inner {
      gap: 30px;
    }

    .faq-inner > h2 {
      margin-bottom: 38px;
    }
  }

  @media (max-width: 420px) {
    .hero {
      height: 920px;
    }

    .hero-copy {
      padding-top: 96px;
    }

    .hero-picker {
      bottom: 30px;
    }
  }
</style>
