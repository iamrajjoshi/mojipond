---
import HeroPicker from "../components/HeroPicker.astro";
import PondScene from "../components/PondScene.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "MojiPond — emoji shortcuts and custom packs for macOS";
const description =
  "Type emoji shortcuts beside the cursor on macOS, then choose with the arrow keys and keep writing.";
---

<BaseLayout title={title} description={description}>
  <section class="hero" aria-labelledby="hero-title">
    <PondScene />
    <div class="hero-copy">
      <h1 id="hero-title">
        <span>Type <span class="shortcode">:wave:</span>.</span>
        <span>Get 👋.</span>
      </h1>
      <p class="hero-summary">
        <span>MojiPond puts emoji suggestions beside your cursor.</span>
        <span>Pick one and keep typing.</span>
      </p>
    </div>

    <div class="hero-picker-shell">
      <HeroPicker />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    width: 100%;
    min-height: 100dvh;
    padding: 112px 24px 48px;
    overflow: hidden;
    align-items: center;
    flex-direction: column;
    background: #06333d;
    isolation: isolate;
  }

  .hero::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(0 27 34 / 12%) 0%,
      transparent 30%,
      rgb(0 21 28 / 18%) 100%
    );
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(calc(100% - 48px), 760px);
    margin: 0 auto;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .hero h1 {
    display: grid;
    gap: 2px;
    margin-bottom: 18px;
    color: #f5fffd;
    font-size: clamp(3.25rem, 6vw, 5.25rem);
    font-weight: 650;
    line-height: 0.96;
    letter-spacing: -0.06em;
    text-shadow: 0 3px 24px rgb(0 20 28 / 32%);
  }

  .hero h1 .shortcode {
    color: #80e8d8;
    font-family: var(--font-mono);
    font-size: 0.86em;
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  .hero-copy > p {
    max-width: 620px;
    margin-bottom: 0;
    color: rgb(235 255 251 / 82%);
    font-size: 1.125rem;
    line-height: 1.75rem;
    text-shadow: 0 2px 16px rgb(0 20 28 / 45%);
  }

  .hero-summary span {
    display: block;
  }

  .hero-picker-shell {
    position: relative;
    z-index: 2;
    width: min(calc(100% - 48px), 740px);
    margin: 30px auto 0;
  }

  @media (max-width: 820px) {
    .hero h1 {
      font-size: 3.75rem;
    }

    .hero-picker-shell {
      width: min(calc(100% - 24px), 700px);
    }
  }

  @media (max-width: 520px) {
    .hero {
      padding: 88px 12px 32px;
    }

    .hero-copy {
      width: calc(100% - 32px);
    }

    .hero h1 {
      margin-bottom: 16px;
      font-size: 3rem;
    }

    .hero-copy > p {
      font-size: 1rem;
      line-height: 1.5rem;
    }

    .hero-picker-shell {
      width: 100%;
      margin-top: 24px;
    }
  }

  @media (max-height: 980px) and (min-width: 521px) {
    .hero {
      padding-top: 92px;
    }

    .hero h1 {
      margin-bottom: 16px;
      font-size: 3.75rem;
    }

    .hero-picker-shell {
      margin-top: 24px;
    }
  }

  @media (max-height: 850px) and (min-width: 521px) {
    .hero {
      padding: 76px 24px 24px;
    }

    .hero h1 {
      margin-bottom: 12px;
      font-size: 3.5rem;
    }

    .hero-copy > p {
      font-size: 1rem;
      line-height: 1.45rem;
    }

    .hero-picker-shell {
      margin-top: 16px;
    }
  }
</style>
