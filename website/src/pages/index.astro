---
import HeroPicker from "../components/HeroPicker.astro";
import PondScene from "../components/PondScene.astro";
import ShortcodeDemo from "../components/ShortcodeDemo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "MojiPond — emoji shortcuts and custom packs for macOS";
const description =
  "Type emoji shortcuts beside the cursor on macOS, then choose with the arrow keys and keep writing.";
---

<BaseLayout title={title} description={description}>
  <section class="hero" aria-labelledby="hero-title">
    <PondScene />
    <div class="hero-copy">
      <h1 id="hero-title">
        <span>Type <span class="shortcode">:wave:</span>.</span>
        <span>Get 👋.</span>
      </h1>
      <p class="hero-summary">
        <span>MojiPond puts emoji suggestions beside your cursor.</span>
        <span>Pick one and keep typing.</span>
      </p>
      <a class="button hero-button" href="#try"
        >Try it yourself <span aria-hidden="true">↓</span></a
      >
    </div>

    <div class="hero-picker-shell">
      <HeroPicker />
    </div>
  </section>

  <section
    class="demo-section section-shell"
    id="try"
    aria-labelledby="try-title"
  >
    <div class="demo-intro">
      <p class="eyebrow">Try it here</p>
      <h2 id="try-title">Start with a colon.</h2>
      <p>
        Type <code>:wa</code>, use the arrow keys, then press Tab or Return. The
        field below behaves like MojiPond's picker.
      </p>
    </div>
    <ShortcodeDemo />
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    width: 100%;
    min-height: 100dvh;
    padding: 112px 24px 48px;
    overflow: hidden;
    align-items: center;
    flex-direction: column;
    background: #06333d;
    isolation: isolate;
  }

  .hero::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(0 27 34 / 12%) 0%,
      transparent 30%,
      rgb(0 21 28 / 18%) 100%
    );
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(calc(100% - 48px), 760px);
    margin: 0 auto;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .hero h1 {
    display: grid;
    gap: 2px;
    margin-bottom: 18px;
    color: #f5fffd;
    font-size: clamp(3.25rem, 6vw, 5.25rem);
    font-weight: 650;
    line-height: 0.96;
    letter-spacing: -0.06em;
    text-shadow: 0 3px 24px rgb(0 20 28 / 32%);
  }

  .hero h1 .shortcode {
    color: #80e8d8;
    font-family: var(--font-mono);
    font-size: 0.86em;
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  .hero-copy > p {
    max-width: 620px;
    margin-bottom: 20px;
    color: rgb(235 255 251 / 82%);
    font-size: 1.125rem;
    line-height: 1.75rem;
    text-shadow: 0 2px 16px rgb(0 20 28 / 45%);
  }

  .hero-summary span {
    display: block;
  }

  .hero-copy .button {
    gap: 8px;
  }

  .hero-button {
    color: var(--deep-water);
    background: rgb(248 255 253 / 94%);
    border-color: rgb(225 255 249 / 52%);
    box-shadow: 0 12px 32px rgb(0 24 31 / 24%);
    backdrop-filter: blur(12px);
  }

  .hero-button:hover {
    color: var(--deep-water);
    background: white;
    border-color: white;
    transform: translateY(-1px);
  }

  .hero-picker-shell {
    position: relative;
    z-index: 2;
    width: min(calc(100% - 48px), 560px);
    margin: 34px auto 0;
  }

  .demo-section {
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
    gap: 80px;
    padding-top: 96px;
    padding-bottom: 96px;
    align-items: start;
  }

  .demo-intro {
    padding-top: 48px;
  }

  .demo-intro h2 {
    margin-bottom: 24px;
    color: var(--deep-water);
    font-size: 3rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .demo-intro > p:last-child {
    max-width: 430px;
    margin-bottom: 0;
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.5rem;
  }

  .demo-intro code {
    color: var(--pond);
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .hero h1 {
      font-size: 3.75rem;
    }

    .demo-section {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 80px;
      padding-bottom: 80px;
    }

    .demo-intro {
      padding-top: 0;
    }

    .demo-intro > p:last-child {
      max-width: 620px;
    }
  }

  @media (max-width: 520px) {
    .hero {
      padding: 88px 12px 32px;
    }

    .hero-copy {
      width: calc(100% - 32px);
    }

    .hero h1 {
      margin-bottom: 16px;
      font-size: 3rem;
    }

    .hero-copy > p {
      margin-bottom: 24px;
      font-size: 1rem;
      line-height: 1.5rem;
    }

    .hero-picker-shell {
      width: 100%;
      margin-top: 28px;
    }

    .demo-section {
      gap: 32px;
      padding-top: 64px;
      padding-bottom: 64px;
    }

    .demo-intro h2 {
      margin-bottom: 16px;
      font-size: 2.25rem;
      line-height: 2.5rem;
    }
  }

  @media (max-height: 980px) and (min-width: 521px) {
    .hero {
      padding-top: 92px;
    }

    .hero h1 {
      margin-bottom: 16px;
      font-size: 3.75rem;
    }

    .hero-copy > p {
      margin-bottom: 16px;
    }

    .hero-picker-shell {
      margin-top: 24px;
    }
  }
</style>
