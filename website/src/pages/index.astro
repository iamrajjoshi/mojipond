---
import HeroPicker from "../components/HeroPicker.astro";
import PondScene from "../components/PondScene.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "MojiPond — emoji shortcuts and custom packs for macOS";
const description =
  "Type emoji shortcuts beside the cursor on macOS, then choose with the arrow keys and keep writing.";
const downloadURL = import.meta.env.PUBLIC_DOWNLOAD_URL?.trim();
---

<BaseLayout title={title} description={description}>
  <section class="hero" aria-labelledby="hero-title">
    <PondScene />
    <div class="hero-copy">
      <h1 id="hero-title" aria-label="Type :wave: Get 👋">
        <span class="hero-heading-final" aria-hidden="true" data-heading-final>
          <span>Type <span class="shortcode">:wave:</span></span>
          <span>Get 👋</span>
        </span>
        <span class="hero-heading-demo" aria-hidden="true" data-heading-demo>
          <span class="heading-demo-action">
            <span class="heading-demo-type">Type</span>
            <span class="heading-demo-get">Get</span>
          </span>
          <span class="heading-demo-value">
            <span class="heading-demo-code">:wave:</span>
            <span class="heading-demo-result">👋</span>
          </span>
        </span>
      </h1>
      <p class="hero-summary">
        <span>MojiPond puts emoji suggestions beside your cursor.</span>
        <span>Pick one and keep typing.</span>
      </p>
    </div>

    <div class="hero-picker-shell">
      <HeroPicker />
      {
        downloadURL && (
          <a
            class="hero-download"
            href={downloadURL}
            aria-label="Download MojiPond for macOS"
          >
            Download for Mac
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 112px 24px 48px;
    overflow: hidden;
    align-items: center;
    flex-direction: column;
    background: #06333d;
    isolation: isolate;
  }

  .hero::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(0 27 34 / 12%) 0%,
      transparent 30%,
      rgb(0 21 28 / 18%) 100%
    );
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(calc(100% - 48px), 760px);
    margin: 0 auto;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .hero h1 {
    position: relative;
    margin-bottom: 18px;
    color: #f5fffd;
    font-size: clamp(3.25rem, 6vw, 5.25rem);
    font-weight: 650;
    line-height: 0.96;
    letter-spacing: -0.045em;
    text-shadow: 0 3px 24px rgb(0 20 28 / 32%);
  }

  .hero-heading-final {
    display: grid;
    gap: 2px;
    opacity: 0;
    transform: translateY(8px);
    animation: heading-final-in 360ms ease 2.85s forwards;
  }

  .hero-heading-demo {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: heading-demo-out 260ms ease 2.8s forwards;
  }

  .heading-demo-action,
  .heading-demo-value {
    display: inline-grid;
    align-items: center;
  }

  .heading-demo-action {
    margin-right: 0.18em;
  }

  .heading-demo-action > span,
  .heading-demo-value > span {
    grid-area: 1 / 1;
  }

  .heading-demo-get {
    opacity: 0;
    animation: heading-result-in 220ms ease 1.9s forwards;
  }

  .heading-demo-type {
    animation: heading-result-out 180ms ease 1.85s forwards;
  }

  .heading-demo-value {
    width: 0;
    overflow: hidden;
    border-right: 0.055em solid #80e8d8;
    color: #80e8d8;
    font-family: var(--font-mono);
    font-size: 0.86em;
    font-weight: 700;
    letter-spacing: -0.06em;
    text-align: left;
    animation:
      heading-value-type 1.3s steps(6, end) 300ms forwards,
      heading-caret 520ms step-end 300ms 3,
      heading-value-collapse 260ms ease 1.85s forwards,
      heading-value-border-out 1ms linear 1.85s forwards;
  }

  .heading-demo-code {
    display: inline-flex;
    width: 6ch;
    white-space: nowrap;
    animation: heading-result-out 180ms ease 1.85s forwards;
  }

  .heading-demo-result {
    display: inline-flex;
    align-items: baseline;
    opacity: 0;
    color: #f5fffd;
    font-family: var(--font-display);
    font-size: 1.12em;
    letter-spacing: normal;
    transform: scale(0.72) rotate(-8deg);
    animation: heading-emoji-in 260ms cubic-bezier(0.2, 0.9, 0.25, 1.3) 1.87s
      forwards;
  }

  .hero h1 .shortcode {
    color: #80e8d8;
    font-family: var(--font-mono);
    font-size: 0.86em;
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  @keyframes heading-value-type {
    to {
      width: 6ch;
    }
  }

  @keyframes heading-caret {
    50% {
      border-color: transparent;
    }
  }

  @keyframes heading-result-out {
    to {
      border-color: transparent;
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @keyframes heading-result-in {
    from {
      opacity: 0;
      transform: translateY(5px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heading-value-collapse {
    from {
      width: 6ch;
    }

    to {
      width: 1.28em;
    }
  }

  @keyframes heading-value-border-out {
    to {
      border-color: transparent;
    }
  }

  @keyframes heading-emoji-in {
    to {
      opacity: 1;
      transform: scale(1) rotate(0);
    }
  }

  @keyframes heading-demo-out {
    to {
      opacity: 0;
      transform: translateY(-8px);
      visibility: hidden;
    }
  }

  @keyframes heading-final-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-copy > p {
    max-width: 620px;
    margin-bottom: 0;
    color: rgb(235 255 251 / 82%);
    font-size: 1.125rem;
    line-height: 1.75rem;
    text-shadow: 0 2px 16px rgb(0 20 28 / 45%);
  }

  .hero-summary span {
    display: block;
  }

  .hero-picker-shell {
    position: relative;
    z-index: 2;
    width: min(calc(100% - 48px), 740px);
    margin: 30px auto 0;
  }

  .hero-download {
    display: flex;
    width: max-content;
    min-height: 46px;
    padding: 9px 20px;
    margin: 12px auto 0;
    align-items: center;
    justify-content: center;
    color: var(--deep-water);
    font-size: 0.95rem;
    font-weight: 750;
    text-decoration: none;
    background: #f5fffd;
    border: 1px solid rgb(245 255 253 / 70%);
    border-radius: 999px;
    box-shadow: 0 12px 34px rgb(0 20 28 / 28%);
  }

  .hero-download:hover {
    color: var(--deep-water);
    background: #fff;
    border-color: #fff;
    transform: translateY(-1px);
  }

  .hero-download:active {
    transform: translateY(0) scale(0.98);
  }

  @media (max-width: 820px) {
    .hero h1 {
      font-size: 3.75rem;
    }

    .hero-picker-shell {
      width: min(calc(100% - 24px), 700px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-heading-demo {
      display: none;
      animation: none !important;
    }

    .hero-heading-final {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
  }

  @media (max-width: 520px) {
    .hero {
      padding: 88px 12px 16px;
    }

    .hero-copy {
      width: calc(100% - 32px);
    }

    .hero h1 {
      margin-bottom: 16px;
      font-size: 3rem;
    }

    .hero-copy > p {
      font-size: 1rem;
      line-height: 1.5rem;
    }

    .hero-picker-shell {
      width: 100%;
      margin-top: 24px;
    }

    .hero-download {
      min-height: 42px;
      padding: 8px 17px;
      margin-top: 12px;
      font-size: 0.9rem;
    }
  }

  @media (max-height: 980px) and (min-width: 521px) {
    .hero {
      padding-top: 92px;
    }

    .hero h1 {
      margin-bottom: 16px;
      font-size: 3.75rem;
    }

    .hero-picker-shell {
      margin-top: 24px;
    }
  }

  @media (max-height: 1050px) and (min-width: 521px) {
    .hero {
      padding-top: 52px;
    }
  }

  @media (max-height: 850px) and (min-width: 521px) {
    .hero {
      padding: 76px 24px 24px;
    }

    .hero h1 {
      margin-bottom: 12px;
      font-size: 3.5rem;
    }

    .hero-copy > p {
      font-size: 1rem;
      line-height: 1.45rem;
    }

    .hero-picker-shell {
      margin-top: 16px;
    }
  }

  @media (max-height: 740px) and (min-width: 650px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
      gap: 20px;
      padding: 68px 20px 12px;
      align-items: center;
    }

    .hero-copy,
    .hero-picker-shell {
      width: 100%;
      margin: 0;
    }

    .hero h1 {
      margin-bottom: 12px;
      font-size: clamp(2.5rem, 6vw, 3.25rem);
    }

    .hero-copy > p {
      font-size: 0.92rem;
      line-height: 1.3rem;
    }
  }

  @media (max-height: 520px) and (min-width: 650px) {
    .hero-download {
      margin-top: 4px;
    }
  }

  @media (max-width: 520px) and (max-height: 740px) {
    .hero {
      padding: 68px 8px 8px;
    }

    .hero h1 {
      margin-bottom: 8px;
      font-size: 2.5rem;
    }

    .hero-copy > p {
      font-size: 0.9rem;
      line-height: 1.25rem;
    }

    .hero-picker-shell {
      margin-top: 10px;
    }

    .hero-download {
      min-height: 38px;
      padding: 6px 15px;
      margin-top: 8px;
      font-size: 0.82rem;
    }
  }
</style>
