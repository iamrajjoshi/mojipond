---
import HeroPicker from "../components/HeroPicker.astro";
import PondScene from "../components/PondScene.astro";
import ShortcodeDemo from "../components/ShortcodeDemo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "MojiPond — emoji shortcuts and custom packs for macOS";
const description =
  "Type emoji shortcuts beside the cursor on macOS, then choose with the arrow keys and keep writing.";
---

<BaseLayout title={title} description={description}>
  <section class="hero" aria-labelledby="hero-title">
    <PondScene />
    <div class="hero-copy">
      <h1 id="hero-title">
        Type <span class="shortcode">:wave:</span><br />Get 👋
      </h1>
      <p class="hero-summary">
        <span>MojiPond puts emoji suggestions beside your cursor.</span>
        <span>Pick one and keep typing.</span>
      </p>
      <a class="button primary" href="#try"
        >Try it <span aria-hidden="true">↓</span></a
      >
    </div>

    <div class="hero-picker-shell">
      <HeroPicker />
    </div>
  </section>

  <section
    class="demo-section section-shell"
    id="try"
    aria-labelledby="try-title"
  >
    <div class="demo-intro">
      <p class="eyebrow">Try it here</p>
      <h2 id="try-title">Start with a colon.</h2>
      <p>
        Type <code>:wa</code>, use the arrow keys, then press Tab or Return. The
        field below behaves like MojiPond's picker.
      </p>
    </div>
    <ShortcodeDemo />
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    overflow: hidden;
    background: #d9efec;
    isolation: isolate;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(calc(100% - 48px), 760px);
    padding-top: 128px;
    margin: 0 auto;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .hero h1 {
    margin-bottom: 24px;
    color: var(--deep-water);
    font-size: 4.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .hero h1 .shortcode {
    color: var(--pond);
    font-family: var(--font-mono);
    font-size: 0.86em;
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  .hero-copy > p {
    max-width: 620px;
    margin-bottom: 24px;
    color: #244e54;
    font-size: 1.125rem;
    line-height: 1.75rem;
  }

  .hero-summary span {
    display: block;
  }

  .hero-copy .button {
    gap: 8px;
  }

  .hero-picker-shell {
    position: absolute;
    bottom: -64px;
    left: 50%;
    z-index: 2;
    width: min(calc(100% - 48px), 500px);
    transform: translateX(-50%);
  }

  .demo-section {
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
    gap: 80px;
    padding-top: 96px;
    padding-bottom: 96px;
    align-items: start;
  }

  .demo-intro {
    padding-top: 48px;
  }

  .demo-intro h2 {
    margin-bottom: 24px;
    color: var(--deep-water);
    font-size: 3rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .demo-intro > p:last-child {
    max-width: 430px;
    margin-bottom: 0;
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.5rem;
  }

  .demo-intro code {
    color: var(--pond);
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .hero-copy {
      padding-top: 112px;
    }

    .hero h1 {
      font-size: 3.75rem;
    }

    .demo-section {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 80px;
      padding-bottom: 80px;
    }

    .demo-intro {
      padding-top: 0;
    }

    .demo-intro > p:last-child {
      max-width: 620px;
    }
  }

  @media (max-width: 520px) {
    .hero-copy {
      width: calc(100% - 32px);
      padding-top: 112px;
    }

    .hero h1 {
      margin-bottom: 16px;
      font-size: 3rem;
    }

    .hero-copy > p {
      margin-bottom: 24px;
      font-size: 1rem;
      line-height: 1.5rem;
    }

    .hero-picker-shell {
      bottom: -32px;
      width: calc(100% - 24px);
    }

    .demo-section {
      gap: 32px;
      padding-top: 64px;
      padding-bottom: 64px;
    }

    .demo-intro h2 {
      margin-bottom: 16px;
      font-size: 2.25rem;
      line-height: 2.5rem;
    }
  }

  @media (max-height: 760px) and (min-width: 521px) {
    .hero-copy {
      padding-top: 96px;
    }

    .hero h1 {
      margin-bottom: 16px;
      font-size: 3.75rem;
    }

    .hero-copy > p {
      margin-bottom: 16px;
    }

    .hero-picker-shell {
      bottom: -56px;
      width: 400px;
    }
  }

  @media (max-height: 600px) {
    .hero {
      min-height: 760px;
    }
  }
</style>
