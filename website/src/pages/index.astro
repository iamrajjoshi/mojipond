---
import { Image } from "astro:assets";
import caretSuggestions from "../../../docs/screenshots/caret-suggestions.png";
import PondScene from "../components/PondScene.astro";
import ShortcodeDemo from "../components/ShortcodeDemo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "MojiPond — emoji shortcuts and custom packs for macOS";
const description =
  "Type emoji shortcuts beside the cursor on macOS, then choose with the arrow keys and keep writing.";

const details = [
  {
    question: "What happens?",
    answer:
      "Type a colon and a name. A picker opens beside your cursor. Choose with the arrow keys, then press Tab or Return.",
  },
  {
    question: "What happens to animated emoji?",
    answer:
      "On macOS 15 or later, MojiPond prepares frame 0 as a static inline glyph. macOS 14 uses a media fallback. The original animation stays in your library.",
  },
  {
    question: "What ZIP files can I import?",
    answer:
      "A ZIP can contain a folder of PNG, JPEG, GIF, or WebP files, a mojipond.json manifest, or a Slack emoji.json file with local artwork. You review names and conflicts before anything installs.",
  },
  {
    question: "Why does it need macOS permissions?",
    answer:
      "Input Monitoring lets MojiPond notice a shortcut. Accessibility finds the cursor and replaces the selected token. Event Posting is optional for Unicode shortcuts; MojiPond uses it to paste custom images in Messages and to replay Return when you enable Return to send.",
  },
  {
    question: "Where does it work?",
    answer:
      "Shortcuts work in supported text fields on macOS 14 or newer. MojiPond stays out of password fields, terminals, remote desktop apps, Slack, Discord, and anything you exclude. Custom images insert only in Messages.",
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="hero" aria-labelledby="hero-title">
    <PondScene />
    <div class="hero-copy">
      <h1 id="hero-title">
        Type <span class="shortcode">:wave:</span><br />Get 👋
      </h1>
      <p>
        MojiPond puts emoji suggestions beside your cursor. Pick one and keep
        typing.
      </p>
      <a class="button primary" href="#try"
        >Try it <span aria-hidden="true">↓</span></a
      >
    </div>

    <figure class="hero-picker">
      <Image
        src={caretSuggestions}
        alt="MojiPond suggestions beside a typed frog shortcut, with Frog selected"
        width={760}
        height={558}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section
    class="demo-section section-shell"
    id="try"
    aria-labelledby="try-title"
  >
    <div class="demo-intro">
      <p class="eyebrow">Try it here</p>
      <h2 id="try-title">Start with a colon.</h2>
      <p>
        Type <code>:wa</code>, use the arrow keys, then press Tab or Return. The
        field below behaves like MojiPond's picker.
      </p>
    </div>
    <ShortcodeDemo />
  </section>

  <section
    class="details-section section-shell"
    aria-labelledby="details-title"
  >
    <h2 class="sr-only" id="details-title">About MojiPond</h2>
    <dl class="details-list">
      {
        details.map((item) => (
          <div class="detail-row">
            <dt>{item.question}</dt>
            <dd>{item.answer}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    overflow: hidden;
    background: #d9efec;
    isolation: isolate;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(calc(100% - 48px), 760px);
    padding-top: 128px;
    margin: 0 auto;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .hero h1 {
    margin-bottom: 24px;
    color: var(--deep-water);
    font-size: 4.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .hero h1 .shortcode {
    color: var(--pond);
    font-family: var(--font-mono);
    font-size: 0.86em;
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  .hero-copy > p {
    max-width: 620px;
    margin-bottom: 24px;
    color: #244e54;
    font-size: 1.125rem;
    line-height: 1.75rem;
  }

  .hero-copy .button {
    gap: 8px;
  }

  .hero-picker {
    position: absolute;
    bottom: -64px;
    left: 50%;
    z-index: 2;
    width: min(calc(100% - 48px), 500px);
    margin: 0;
    overflow: hidden;
    background: var(--paper-strong);
    border: 1px solid rgb(6 51 61 / 18%);
    border-radius: 24px;
    box-shadow: 0 40px 96px rgb(6 51 61 / 24%);
    transform: translateX(-50%);
  }

  .hero-picker img {
    display: block;
    width: 100%;
    height: auto;
  }

  .demo-section {
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
    gap: 80px;
    padding-top: 96px;
    padding-bottom: 96px;
    align-items: start;
  }

  .demo-intro {
    padding-top: 48px;
  }

  .demo-intro h2 {
    margin-bottom: 24px;
    color: var(--deep-water);
    font-size: 3rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .demo-intro > p:last-child {
    max-width: 430px;
    margin-bottom: 0;
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.5rem;
  }

  .demo-intro code {
    color: var(--pond);
    font-weight: 700;
  }

  .details-section {
    padding-top: 32px;
    padding-bottom: 96px;
  }

  .details-list {
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .detail-row {
    display: grid;
    grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr);
    gap: 64px;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--deep-water);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.75rem;
  }

  dd {
    max-width: 680px;
    margin: 0;
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.5rem;
  }

  @media (max-width: 820px) {
    .hero-copy {
      padding-top: 112px;
    }

    .hero h1 {
      font-size: 3.75rem;
    }

    .demo-section {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 80px;
      padding-bottom: 80px;
    }

    .demo-intro {
      padding-top: 0;
    }

    .demo-intro > p:last-child {
      max-width: 620px;
    }

    .detail-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  @media (max-width: 520px) {
    .hero-copy {
      width: calc(100% - 32px);
      padding-top: 112px;
    }

    .hero h1 {
      margin-bottom: 16px;
      font-size: 3rem;
    }

    .hero-copy > p {
      margin-bottom: 24px;
      font-size: 1rem;
      line-height: 1.5rem;
    }

    .hero-picker {
      bottom: -32px;
      width: calc(100% - 24px);
      border-radius: 16px;
    }

    .demo-section {
      gap: 32px;
      padding-top: 64px;
      padding-bottom: 64px;
    }

    .demo-intro h2 {
      margin-bottom: 16px;
      font-size: 2.25rem;
      line-height: 2.5rem;
    }

    .details-section {
      padding-top: 16px;
      padding-bottom: 64px;
    }

    .detail-row {
      padding: 24px 0;
    }
  }

  @media (max-height: 760px) and (min-width: 521px) {
    .hero-copy {
      padding-top: 96px;
    }

    .hero h1 {
      margin-bottom: 16px;
      font-size: 3.75rem;
    }

    .hero-copy > p {
      margin-bottom: 16px;
    }

    .hero-picker {
      bottom: -56px;
      width: 400px;
    }
  }

  @media (max-height: 600px) {
    .hero {
      min-height: 760px;
    }
  }
</style>
