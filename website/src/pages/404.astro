---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Not found — MojiPond"
  description="The requested MojiPond page could not be found."
  noindex
>
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>That shortcut leads nowhere.</h1>
    <p>The page may have moved, or the address was typed wrong.</p>
    <a class="button primary" href="/">Back to MojiPond</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 70vh;
    padding: 96px 20px;
    place-items: center;
    align-content: center;
    text-align: center;
  }

  h1 {
    max-width: 780px;
    margin-bottom: 20px;
  }

  p:not(.eyebrow) {
    margin-bottom: 28px;
    color: var(--ink-muted);
  }
</style>
