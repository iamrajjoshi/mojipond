# This file is a template only. MojiPond and its scripts do not source .env
# automatically. Copy it to .env, fill only the values you need, then run:
#   set -a; source .env; set +a

# Local builds use ad-hoc signing when this remains "-".
MOJIPOND_SIGNING_IDENTITY=-
MOJIPOND_DEVELOPMENT_TEAM=

# Release builds default to a Universal binary. Override only for diagnosis.
MOJIPOND_ARCHS="arm64 x86_64"

# Set to 1 in a release shell to reject accidental ad-hoc packaging.
MOJIPOND_REQUIRE_DEVELOPER_ID=0

# Sparkle's appcast URL and public Ed25519 key are pinned in project.yml. The
# private key belongs in the protected GitHub environment secret named
# SPARKLE_EDDSA_PRIVATE_KEY, never in this file.

# Optional build cache location. The default is ./DerivedData.
# MOJIPOND_DERIVED_DATA_PATH=/absolute/path/to/DerivedData
